# Google OAuth web client id. The frontend uses the same value as VITE_GOOGLE_CLIENT_ID.
# Missing → sign-in fails closed (500, no token).
GOOGLE_CLIENT_ID=

# Secret for the JWT we issue after Google sign-in. Long random string.
# Missing or blank → sign-in and guarded routes fail closed (500, no token).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated household emails. Compared case-insensitively.
# Missing, blank, or only commas → fail closed. Nobody gets a token, and an old token stops working.
ALLOWED_EMAILS=roee@example.com,aviv@example.com

# Browser origin for local CORS. Production calls are same-origin via /api.
CLIENT_ORIGIN=http://localhost:5173

PORT=3000

# Service account key as one JSON object (the Vercel variable GOOGLE_SERVICE_ACCOUNT_JSON).
# Never commit a real value, and never put this in the frontend.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
