# Google OAuth web client id. The frontend uses the same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Secret for the JWT we issue after Google sign-in. Long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated. Compared case-insensitively. Empty list rejects everyone.
ALLOWED_EMAILS=roee@example.com,aviv@example.com

# Browser origin for local CORS. Production calls are same-origin via /api.
CLIENT_ORIGIN=http://localhost:5173

PORT=3000

# PR #2 — the service account stays on the server. Never put these in the frontend.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
