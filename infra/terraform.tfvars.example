# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id      = "home-finance-change-me"
project_name    = "home-finance"
billing_account = "000000-000000-000000"

# The long id in https://docs.google.com/spreadsheets/d/<id>/edit
google_sheet_id = "replace-with-spreadsheet-id"

# Existing project. Terraform reads this name and does not create it.
vercel_project_name = "home-finance"

# Personal account: leave this unset. A team slug or id goes here only if you use one.
# vercel_team_id = "team_xxxxxxxx"
