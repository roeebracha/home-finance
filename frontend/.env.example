# Google OAuth web client. Same id as GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=

# Leave empty in local dev: Vite proxies /api to http://localhost:3000.
# On Vercel, leave empty as well — the site and the API share one origin.
VITE_API_URL=

# Optional base URL for the garden backend (nissim-smart-garden).
# Leave empty until that API exists. The app does not call it yet.
# Not a secret — do not put tokens here.
VITE_GARDEN_API_URL=
